# Production settings for docker-compose.prod.yml. Copy to .env on the server (it is git-ignored),
# fill in every value, and keep the file readable only by you: chmod 600 .env
# Full guide: docs/deployment.md

# --- Public address ---
# The DNS name pointing at this server. Caddy gets a Let's Encrypt certificate for it.
PULSEWATCH_DOMAIN=status.example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=admin@example.com

# --- Database ---
POSTGRES_DB=pulsewatch
POSTGRES_USER=pulsewatch
# Letters and digits only (it is placed in a connection string). Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Accounts ---
# false = nobody can sign up. Set true only while you create your own account(s), then back to false.
REGISTRATION_ENABLED=false
MAX_MONITORS_PER_USER=20

# --- Alert emails (SMTP) ---
# Smtp sends real email; Logging only writes alerts to the worker log.
EMAIL_PROVIDER=Smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=alerts@example.com

# --- Optional ---
# Image tag used for the built images (e.g. a git tag). Handy for rollbacks.
PULSEWATCH_VERSION=local
# OpenTelemetry Collector for metrics and traces, e.g. http://otel-collector:4317. Empty = off.
OTLP_ENDPOINT=
# Change only if these subnets clash with networks on your server. EGRESS_SUBNET is used in the firewall rules.
EDGE_SUBNET=172.30.10.0/24
EGRESS_SUBNET=172.30.20.0/24
# Host ports for Caddy.
HTTP_PORT=80
HTTPS_PORT=443
