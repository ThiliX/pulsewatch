# Copy to .env (git-ignored) and fill in local values. Never commit real credentials.

# --- Docker Compose: PostgreSQL ---
POSTGRES_DB=pulsewatch
POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=<choose-a-local-password>
POSTGRES_PORT=5432

# --- Docker Compose: Mailpit (local test inbox) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Application settings (used from Milestone 1 onward) ---
# For `dotnet run`, prefer user-secrets instead of environment variables:
#   dotnet user-secrets set "ConnectionStrings:PulseWatch" "<connection string>" --project src/PulseWatch.Api
#   dotnet user-secrets set "ConnectionStrings:PulseWatch" "<connection string>" --project src/PulseWatch.Worker
ConnectionStrings__PulseWatch=Host=localhost;Port=5432;Database=pulsewatch;Username=pulsewatch;Password=<same-as-above>

Monitoring__PollIntervalSeconds=5
Monitoring__DefaultIntervalSeconds=60
Monitoring__MinimumIntervalSeconds=60
Monitoring__MaximumIntervalSeconds=3600
Monitoring__MaxTimeoutMs=15000
Monitoring__MaxConcurrentChecks=10
Monitoring__MaxMonitorsPerUser=20
Monitoring__CheckRetentionDays=30

# Logging (default) writes emails to the worker log; Smtp sends them (Mailpit settings below).
Notifications__Provider=Logging
Notifications__MaxAttempts=6
Email__Host=localhost
Email__Port=1025
# false only for a local test server such as Mailpit; keep true for real providers.
Email__UseStartTls=false
Email__Username=
Email__Password=
Email__FromAddress=alerts@pulsewatch.localhost
# Links in alert emails point here.
App__PublicBaseUrl=http://localhost:5173

# --- Operations (Milestone 7) ---
# Daily cleanup of checks older than Monitoring__CheckRetentionDays (incidents and emails are kept).
Retention__IntervalHours=24
Retention__BatchSize=5000
# Export metrics and traces to an OpenTelemetry Collector. Empty = off.
Telemetry__OtlpEndpoint=
# Console log format: json (default outside Development) or simple.
# Logging__Console__FormatterName=json
