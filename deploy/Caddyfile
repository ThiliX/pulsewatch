# Caddy terminates HTTPS (certificates from Let's Encrypt, renewed automatically) and forwards to the API.
# PULSEWATCH_DOMAIN and ACME_EMAIL come from .env via docker-compose.prod.yml.
{
	email {$ACME_EMAIL}
	admin off
}

{$PULSEWATCH_DOMAIN} {
	# Compress only the static web app. API responses are left alone: compressing secrets next to
	# attacker-influenced text in the same response is what the BREACH attack relies on.
	@assets path /assets/*
	encode @assets zstd gzip

	reverse_proxy api:8080 {
		health_uri /health/live
		health_interval 30s
	}

	header -Server

	log {
		output stdout
		format json
	}
}
